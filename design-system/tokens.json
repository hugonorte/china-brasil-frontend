{
  "meta": {
    "name": "ChinaBrasil Design System",
    "version": "1.0.0",
    "language": "pt-BR",
    "purpose": "Especificação base para modernizar o site institucional chinabrasil.com — consultoria e intermediação de negócios entre China e Brasil (importação, sourcing, representação comercial).",
    "design_direction": [
      "confiança institucional e internacional",
      "ponte entre duas culturas: sóbrio + um acento de identidade",
      "editorial e corporativo, sem parecer 'agência de marketing'",
      "alto contraste em seções escuras, muito espaço em branco nas claras",
      "cantos levemente arredondados, nada de exagero 'startup'",
      "fotografia de portos, indústria, comércio e reuniões de negócio",
      "orientado a conversão: geração de contato/orçamento"
    ],
    "implementation_notes": {
      "stack": "Nuxt 4 (Vue 3) com pré-renderização estática (nuxt generate / SSG)",
      "recommended_css": "Tailwind CSS via @nuxtjs/tailwindcss, alimentado pelos tokens deste arquivo (ver tailwind.tokens.js)",
      "css_variables": "tokens.css expõe os mesmos valores como custom properties para uso fora do Tailwind (ex.: estilos de terceiros, e-mails, PDFs)",
      "fonts": "auto-hospedar via @nuxt/fonts ou @nuxtjs/google-fonts com display=swap; nunca depender de CDN externo em produção",
      "icons": "Lucide (via componente Vue, tree-shakeable) — coerente com o estilo 'thin line'",
      "responsive_strategy": "mobile-first",
      "accessibility_target": "WCAG 2.2 AA",
      "image_strategy": "WebP/AVIF responsivo, lazy-loading abaixo da dobra, <NuxtImg> quando @nuxt/image estiver instalado",
      "i18n_note": "conteúdo primário em pt-BR; estrutura pronta para variante em inglês/mandarim (zh-Hans) no futuro"
    }
  },

  "brand": {
    "name": "ChinaBrasil",
    "tagline": "Sua ponte de negócios entre a China e o Brasil",
    "brand_personality": ["confiável", "internacional", "experiente", "direta", "sofisticada"],
    "visual_keywords": [
      "comércio exterior",
      "importação e sourcing",
      "relação China-Brasil",
      "logística e cadeia de suprimentos",
      "credibilidade institucional"
    ]
  },

  "design_tokens": {
    "colors": {
      "primary": {
        "red_950": "#2B0808",
        "red_900": "#7A1315",
        "red_800": "#93191A",
        "red_700": "#AE2626",
        "red_600": "#C93838"
      },
      "accent": {
        "jade_700": "#166B52",
        "jade_600": "#1E8566",
        "jade_500": "#2A9E7B"
      },
      "secondary": {
        "gold_700": "#A87B2E",
        "gold_600": "#C79A42",
        "gold_500": "#D9B662",
        "gold_300": "#EDDBA9"
      },
      "neutral": {
        "white": "#FFFFFF",
        "off_white": "#FAF6F5",
        "surface": "#F5F0EE",
        "surface_alt": "#EEE3E0",
        "border": "#E8DEDC",
        "text": "#2A1F1F",
        "text_muted": "#6B5757",
        "text_light": "#A18F8F"
      },
      "semantic": {
        "success": "#1E8566",
        "warning": "#C79A42",
        "error": "#AE2626",
        "info": "#2E6E8E"
      },
      "usage": {
        "page_background": "neutral.off_white",
        "primary_text": "neutral.text",
        "heading_text": "primary.red_950",
        "muted_text": "neutral.text_muted",
        "primary_action": "primary.red_900",
        "secondary_action": "accent.jade_700",
        "highlight": "secondary.gold_600",
        "dark_section": "primary.red_950"
      }
    },

    "typography": {
      "font_families": {
        "display": "'Fraunces', Georgia, serif",
        "body": "'Inter', 'Helvetica Neue', Arial, sans-serif",
        "ui": "'Inter', 'Helvetica Neue', Arial, sans-serif"
      },
      "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "scale": {
        "display_xl": { "font_size": "clamp(2.5rem, 5vw, 4.75rem)", "line_height": 1.02, "letter_spacing": "-0.03em", "weight": 500 },
        "display_lg": { "font_size": "clamp(2.1rem, 4vw, 3.5rem)", "line_height": 1.06, "letter_spacing": "-0.025em", "weight": 500 },
        "heading_xl": { "font_size": "clamp(1.9rem, 3vw, 2.75rem)", "line_height": 1.12, "letter_spacing": "-0.02em", "weight": 500 },
        "heading_lg": { "font_size": "clamp(1.5rem, 2.4vw, 2rem)", "line_height": 1.18, "letter_spacing": "-0.015em", "weight": 600 },
        "heading_md": { "font_size": "1.3rem", "line_height": 1.3, "weight": 600 },
        "body_lg": { "font_size": "1.125rem", "line_height": 1.65, "weight": 400 },
        "body_md": { "font_size": "1rem", "line_height": 1.6, "weight": 400 },
        "body_sm": { "font_size": "0.875rem", "line_height": 1.5, "weight": 400 },
        "caption": { "font_size": "0.72rem", "line_height": 1.4, "letter_spacing": "0.12em", "text_transform": "uppercase", "weight": 600 },
        "button": { "font_size": "0.8rem", "line_height": 1, "letter_spacing": "0.06em", "text_transform": "uppercase", "weight": 600 }
      }
    },

    "spacing": {
      "base_unit": 4,
      "values": {
        "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px",
        "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px", "32": "128px"
      },
      "section_padding": { "desktop": "96px 0", "tablet": "72px 0", "mobile": "56px 0" }
    },

    "layout": {
      "max_width": "1280px",
      "content_width": "1180px",
      "text_width": "640px",
      "grid_columns": 12,
      "gutter": { "desktop": "24px", "tablet": "20px", "mobile": "16px" },
      "breakpoints": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1440px" }
    },

    "radii": { "none": "0", "sm": "4px", "md": "8px", "lg": "14px", "xl": "20px", "2xl": "28px", "pill": "999px" },

    "borders": {
      "subtle": "1px solid #E8DEDC",
      "gold": "1px solid #C79A42",
      "dark": "1px solid rgba(255,255,255,0.16)"
    },

    "shadows": {
      "none": "none",
      "soft": "0 8px 30px rgba(43, 8, 8, 0.07)",
      "card": "0 14px 40px rgba(43, 8, 8, 0.09)",
      "floating": "0 20px 60px rgba(43, 8, 8, 0.18)"
    },

    "motion": {
      "duration_fast": "150ms",
      "duration_normal": "250ms",
      "duration_slow": "450ms",
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "principles": [
        "transições de entrada sutis (fade + translateY pequeno) ao entrar em viewport",
        "sem parallax pesado ou movimento que compita com o conteúdo",
        "respeitar prefers-reduced-motion sempre",
        "hover: elevação leve + mudança de cor, nunca escala agressiva"
      ]
    }
  },

  "components": {
    "logo": {
      "structure": "marca geométrica (ponte/ponte estilizada) + wordmark",
      "variants": ["dark", "light", "monochrome"],
      "minimum_width": "140px",
      "clear_space": "0.5x altura do logo"
    },
    "navigation": {
      "height": { "desktop": "80px", "mobile": "68px" },
      "background": "transparente sobre hero, branco sólido ao rolar (sticky)",
      "items": ["Início", "Sobre", "Serviços", "Como Funciona", "Casos", "Contato"],
      "primary_cta": "Fale com um Especialista",
      "behavior": [
        "sticky com sombra leve após rolagem",
        "menu em drawer abaixo do breakpoint lg",
        "item ativo com sublinhado dourado",
        "foco visível em todos os itens (teclado)"
      ]
    },
    "buttons": {
      "primary": { "background": "primary.red_900", "text": "neutral.white", "radius": "md", "height": "48px", "padding": "0 24px", "hover": "primary.red_950" },
      "accent": { "background": "secondary.gold_600", "text": "primary.red_950", "radius": "md", "height": "48px", "padding": "0 24px", "hover": "secondary.gold_700", "usage": "CTA de maior destaque, sobretudo sobre fundo escuro (dark_section)" },
      "secondary": { "background": "transparent", "text": "primary.red_900", "border": "1px solid primary.red_900", "radius": "md", "height": "48px", "padding": "0 24px", "hover": "primary.red_900 com texto branco" },
      "text_link": { "background": "transparent", "text": "primary.red_900", "underline": "no hover", "icon": "arrow-right" }
    },
    "section_heading": {
      "eyebrow": { "style": "caption", "color": "secondary.gold_700" },
      "title": { "font": "typography.display", "color": "primary.red_950" },
      "description": { "max_width": "640px", "color": "neutral.text_muted" },
      "alignment_variants": ["left", "center"]
    },
    "service_card": {
      "background": "neutral.white",
      "border": "subtle",
      "radius": "lg",
      "padding": "28px 24px",
      "icon": { "style": "thin-line (Lucide)", "color": "primary.red_800", "size": "36px" },
      "title": "heading_md",
      "description": "body_sm",
      "footer": "link uppercase com seta",
      "hover": "sombra soft + translateY(-4px)"
    },
    "process_step": {
      "purpose": "explicar o passo a passo de como a ChinaBrasil conduz uma importação/negociação",
      "marker": "número grande em display font, cor gold_600",
      "connector": "linha vertical/horizontal pontilhada entre etapas",
      "title": "heading_md",
      "description": "body_sm"
    },
    "stat_strip": {
      "background": "primary.red_950",
      "text": "neutral.white",
      "radius": "xl",
      "padding": "28px 36px",
      "columns": 4,
      "dividers": "separadores verticais sutis no desktop",
      "stat_number": { "font": "display", "size": "2.1rem", "color": "secondary.gold_500" },
      "stat_label": { "font": "body_sm", "color": "rgba(255,255,255,0.72)" }
    },
    "testimonial_card": {
      "background": "neutral.white",
      "border": "subtle",
      "radius": "lg",
      "padding": "32px",
      "quote_mark": "aspas grandes em gold",
      "quote_font": "display",
      "attribution": "body_sm com nome da empresa e setor"
    },
    "case_card": {
      "background": "neutral.white",
      "border": "subtle",
      "radius": "lg",
      "overflow": "hidden",
      "image_ratio": "16:9",
      "tag": "setor/indústria em badge pill, background accent.jade_600 a 10% de opacidade, texto accent.jade_700",
      "title": "heading_md",
      "excerpt": "body_sm",
      "link": "link uppercase"
    },
    "trust_bar": {
      "background": "neutral.white",
      "radius": "xl",
      "padding": "24px 32px",
      "label": "caption centralizado ('Empresas que confiam na ChinaBrasil')",
      "logos": "logos monocromáticos de clientes/parceiros",
      "layout": "seis logos no desktop, scroll horizontal no mobile"
    },
    "form": {
      "field_height": "52px",
      "label": "body_sm semibold",
      "background": "neutral.white",
      "border": "subtle",
      "focus_border": "primary.red_800",
      "radius": "md",
      "error_style": "semantic.error com texto de ajuda conciso"
    },
    "footer": {
      "background": "primary.red_950",
      "text": "neutral.white",
      "muted_text": "rgba(255,255,255,0.65)",
      "columns": 4,
      "top_padding": "64px",
      "bottom_padding": "28px",
      "social_icons": "ícones outline pequenos"
    }
  },

  "page_structure": {
    "sections": [
      { "id": "header", "type": "navigation", "purpose": "navegação clara + CTA de contato persistente" },
      {
        "id": "hero",
        "type": "split_hero",
        "purpose": "comunicar autoridade na relação comercial China-Brasil e converter para contato",
        "layout": "duas colunas; texto à esquerda, imagem (porto/indústria/reunião) à direita",
        "elements": ["eyebrow", "headline serif de duas linhas", "parágrafo de apoio", "CTA primário", "CTA secundário", "prova social curta", "painel flutuante com métrica"]
      },
      { "id": "trust", "type": "logo_bar", "purpose": "reforçar credibilidade com logos de clientes/parceiros" },
      {
        "id": "services",
        "type": "service_grid",
        "purpose": "apresentar os serviços principais",
        "recommended_items": ["Sourcing e Prospecção de Fornecedores", "Negociação e Representação Comercial", "Controle de Qualidade (QC)", "Logística e Importação", "Consultoria Regulatória e Aduaneira"]
      },
      { "id": "process", "type": "process_steps", "purpose": "mostrar o passo a passo de uma importação/negociação, reduzindo a percepção de risco", "recommended_steps": 4 },
      { "id": "metrics", "type": "stat_strip", "purpose": "anos de experiência, fornecedores na base, contêineres/processos conduzidos, países atendidos" },
      {
        "id": "about",
        "type": "image_text_split",
        "purpose": "explicar a missão e o diferencial de estar presente nos dois países",
        "elements": ["colagem de imagens", "eyebrow", "título serif", "parágrafo", "três bullets de valor", "CTA secundário"]
      },
      { "id": "cases", "type": "case_grid", "purpose": "casos de sucesso / setores atendidos", "recommended_items": 3 },
      {
        "id": "cta",
        "type": "dark_conversion_banner",
        "purpose": "fechar a página com convite direto para diagnóstico gratuito",
        "background": "primary.red_950",
        "elements": ["ícone", "headline", "frase de apoio", "CTA accent (vermelho)"]
      },
      { "id": "footer", "type": "multi_column_footer", "purpose": "navegação, serviços, contato e informações legais" }
    ]
  },

  "imagery": {
    "style": [
      "fotografia editorial de alta qualidade",
      "portos, contêineres, fábricas e linhas de produção",
      "reuniões de negócio entre pessoas chinesas e brasileiras",
      "luz natural, ambientes reais (não poses genéricas de stock)",
      "acentos de cor vermelha e dourada sobre fundo neutro"
    ],
    "hero_image": {
      "subject": "reunião de negócios ou porto/logística em movimento",
      "composition": "sujeito à direita, espaço negativo à esquerda para o texto",
      "crop": "4:5 ou 3:4",
      "avoid": ["poses de banco de imagens óbvias", "saturação excessiva", "fundos poluídos"]
    },
    "image_overlay": { "allowed": true, "opacity": "0.05 a 0.12", "color": "primary.red_900" }
  },

  "icons": {
    "style": "linha fina, terminais arredondados",
    "stroke_width": "1.5px a 2px",
    "default_color": "primary.red_800",
    "recommended_library": "Lucide Icons (via componente Vue)",
    "common_icons": ["ship", "package", "handshake", "shield-check", "file-check", "globe", "container", "arrow-right", "menu", "chevron-down"]
  },

  "responsive_behavior": {
    "desktop": { "navigation": "menu horizontal completo", "hero": "duas colunas", "service_grid": "três a cinco colunas", "metrics": "quatro colunas", "footer": "quatro colunas" },
    "tablet": { "navigation": "menu condensado ou drawer", "hero": "duas colunas com espaçamento reduzido", "service_grid": "duas colunas", "metrics": "duas colunas", "footer": "duas colunas" },
    "mobile": { "navigation": "hambúrguer com CTA full-width", "hero": "coluna única, imagem abaixo do texto", "service_grid": "coluna única", "metrics": "duas colunas ou empilhado", "footer": "coluna única em acordeão" }
  },

  "accessibility": {
    "requirements": [
      "contraste mínimo 4.5:1 para texto normal",
      "foco visível em todos os elementos interativos",
      "hierarquia semântica de headings (h1 único por página)",
      "alt text descritivo em imagens relevantes, alt vazio em decorativas",
      "navegação mobile acessível por teclado",
      "não depender apenas de cor para status/erro",
      "respeitar prefers-reduced-motion",
      "labels e mensagens de erro em todos os campos de formulário"
    ]
  },

  "content_guidelines": {
    "tone": "direto, confiável, consultivo, sem jargão excessivo",
    "headline_style": "curto, focado em benefício, com peso institucional",
    "body_copy": "linguagem simples, resultados concretos, evitar promessas irreais",
    "cta_verbs": ["Fale com um Especialista", "Solicite um Diagnóstico", "Conheça Nossos Serviços", "Ver Casos de Sucesso"],
    "avoid": ["promessas de economia garantida", "mensagens baseadas em medo", "jargão aduaneiro sem explicação"]
  },

  "implementation_checklist": [
    "Instalar @nuxtjs/tailwindcss e mapear estes tokens em tailwind.config (ver tailwind.tokens.js)",
    "Importar tokens.css globalmente (app/assets/css/tokens.css) para uso fora do Tailwind",
    "Auto-hospedar fontes (Fraunces + Inter) via @nuxt/fonts",
    "Construir componentes reutilizáveis: AppHeader, AppButton, SectionHeading, ServiceCard, ProcessStep, StatStrip, CaseCard, CtaBanner, AppFooter",
    "Validar layout em 320px, 768px, 1024px, 1280px e 1440px",
    "Validar contraste e navegação por teclado",
    "Adicionar metadados SEO/Open Graph e dados estruturados (Organization) via useSeoMeta/useHead",
    "Gerar o site com `nuxt generate` (SSG) e validar todas as rotas estáticas"
  ]
}
